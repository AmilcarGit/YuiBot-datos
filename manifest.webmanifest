{
  "name": "YuiBot-datos",
  "short_name": "YuiBot",
  "description": "Tu progreso en YuiBot-MD: nivel, monedas, ranking mundial y más.",
  "lang": "es",
  "start_url": "/?origen=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1b0d1a",
  "theme_color": "#e91e8c",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Ver el ranking", "url": "/#ranking" },
    { "name": "Buscar mi número", "url": "/#buscar" }
  ]
}
