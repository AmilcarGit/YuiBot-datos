# Variables del servidor (se ponen en Vercel → Settings → Environment Variables, NO en este archivo).
# Las de Upstash las añade Vercel solas al conectar la base (Storage → Upstash Redis).

# Secreto para anonimizar los números de teléfono (cualquier texto largo y aleatorio). OBLIGATORIO.
DATOS_PEPPER=cambia-esto-por-un-texto-largo-y-aleatorio

# Opcionales (valores por defecto entre paréntesis)
# MAX_DELTA_MONEDAS=100000       (monedas máximas que una sincronización puede sumar a un usuario)
# MAX_DELTA_XP=2000
# MAX_GANANCIA_HORA=500000       (tope de monedas que puede ganar un usuario por hora)
# MAX_REGISTROS_IP_HORA=10
# ADMIN_TOKEN=                   (para banear instalaciones: POST /api/admin)
